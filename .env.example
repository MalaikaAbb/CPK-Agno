# Copy to backend/.env (or a repo-root .env) and fill in.
# Never commit the filled-in file.

# ── Required ────────────────────────────────────────────────────────────────

# Model provider key. Read by the Agno process only — it is never sent to the
# browser, because the browser never talks to the agent directly.
OPENAI_API_KEY=sk-...


# ── Backend, optional ───────────────────────────────────────────────────────

# Model the agent runs. The Agno quickstart prints `gpt-5.4`, which is not
# available on every account, so the default here is `gpt-5.4-mini`.
# OPENAI_MODEL=gpt-5.4-mini

# Port for the Agno AgentOS server. Change this and AGNO_AGENT_URL together.
# AGENT_PORT=8010

# How long the agent waits to open a socket to OpenAI, in seconds. The OpenAI
# SDK's own default is 5, which is generous on an idle machine and too tight
# on a heavily loaded one: every demo there failed with "API connection error
# from OpenAI API: Connection error.", which is a connect timeout in disguise. Read
# and write get their own, much longer budget so streaming still works.
# OPENAI_CONNECT_TIMEOUT=30
# OPENAI_REQUEST_TIMEOUT=600
# OPENAI_MAX_RETRIES=5

# Origins allowed to call the agent directly. Only matters if you bypass the
# runtime; the normal path is server-to-server and needs no CORS.
# AGENT_CORS_ORIGINS=http://localhost:3010,http://127.0.0.1:3010


# ── Frontend, optional ──────────────────────────────────────────────────────
# These belong in frontend/.env.local (Next.js does not read this file).

# Where the runtime reaches the Agno AG-UI endpoint. Use 127.0.0.1 if localhost
# resolves to IPv6 while the agent binds IPv4.
# AGNO_AGENT_URL=http://localhost:8010/agui

# CopilotKit Intelligence public license key (browser-safe, `ck_pub_...`).
# No published page wires this to anything any more: the Threads Drawer page
# dropped `publicLicenseKey` on 2026-09-15 and the Inspector page followed on
# 2026-09-21, so entitlement is resolved by the Runtime from the server-side
# project key below. Nothing in `frontend/src` reads this variable; it is kept
# here only for reference.
# NEXT_PUBLIC_COPILOTKIT_LICENSE_KEY=ck_pub_...

# CopilotKit Intelligence project key (server-side, from the free account in
# quickstart step 1). Set it and the runtime routes wire `CopilotKitIntelligence`
# plus `identifyUser`; leave it unset and they fall back to SSE with an
# in-memory runner — chat works, Threads and the Inspector stay locked.
# Renamed by the docs from INTELLIGENCE_API_KEY; both spellings are read.
# CPK_INTELLIGENCE_API_KEY=cpk-...

# Non-secret analytics identity, written by `copilotkit init` alongside the key.
# CPK_TELEMETRY_ID=...

# Opt out of CopilotKit's anonymous runtime telemetry.
# COPILOTKIT_TELEMETRY_DISABLED=true
