# Secrets
.env
.env.local
.env.*.local
!.env.example

# Node
node_modules/
.next/
out/
next-env.d.ts
*.tsbuildinfo

# Python
.venv/
__pycache__/
*.py[cod]

# CopilotKit CLI project metadata (contains project ids)
.copilotkit/

# Editor / OS
.DS_Store
*.log
.claude/
.temp_chunks/

# Autorecorder scratch & output
autorecorder/videos/.temp_chunks/

# Captured terminal sessions from `npm run capture` — build artifacts, and
# they hold whatever the CLI printed on the machine that ran it. Commit one
# deliberately (`git add -f`) when a run is worth keeping as a baseline.
autorecorder/casts/

# Drift reports are derived data — regenerated on every /doc-sync run.
# The snapshot itself (doc-snapshot/pages/, manifest.json, CHANGELOG.md)
# IS committed; it is the baseline every diff is taken against.
doc-snapshot/reports/
